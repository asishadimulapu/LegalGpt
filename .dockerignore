# =============================================================================
# Docker build context exclusions
# =============================================================================

# Version control
.git
.github

# Virtual environments
venv/
env/
.venv/
ENV/

# Node modules (frontend has its own Dockerfile)
node_modules/
frontend/node_modules/
mobile_app/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
dist/
build/
frontend/dist/

# Logs (mounted as volume instead)
logs/
*.log

# Data (mounted as volume instead)
data/legal_pdfs/

# OS files
.DS_Store
Thumbs.db

# Test files
test.db
*.sqlite3
*.db

# Docs
docs/
*.md
!README.md

# Kluster
.kluster/
